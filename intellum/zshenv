export EDITOR=nvim
export BC_ENV_ARGS=$HOME/.bcrc
export LESS=-Ri
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# homebrew
export HOMEBREW_NO_AUTO_UPDATE=1

# ruby
export RUBYOPT="-W0"
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=/opt/homebrew/opt/openssl"

# go
export GOPATH=$HOME/go
export GOROOT=/opt/homebrew/opt/go/libexec
export GOBIN=$GOPATH/bin

# groovy
export GROOVY_HOME=/opt/homebrew/opt/groovy/libexec

# java
export JAVA_HOME=$(/usr/libexec/java_home)

# postgres
export PKG_CONFIG_PATH=/opt/homebrew/opt/postgresql@14/lib/postgresql@14/pkgconfig

# aws
export AWS_PAGER=""
export AWS_PROFILE=intellum-main

# ansible
export ANSIBLE_VAULT_PASSWORD_FILE=./.vault.pass
export ANSIBLE_REMOTE_USER=intellumadmin
export no_proxy=*

# terraform
export NEW_RELIC_REGION=US
export TGENV_ARCH=arm64

# gcloud
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# path
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/sbin
PATH=/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin:$PATH
PATH=/usr/local/opt/mongodb-community@4.0/bin:$PATH
PATH=$GOBIN:$PATH
PATH=$HOME/.local/bin:$PATH
export PATH=$HOME/bin:$PATH

# load function dirs into fpath
if [[ -d $HOME/.functions ]]; then
  for dir in $(find -L $HOME/.functions -type d); do
    fpath=($dir $fpath)
  done
  export fpath
fi

# locals
for file in keys aliases; do
  if [[ -f $HOME/.local/$file ]]; then
    source $HOME/.local/$file
  fi
done

# irb
export IRBRC=~/.irbrc

# zsh syntax highligting
# declare the variable
typeset -A ZSH_HIGHLIGHT_STYLES
# To have paths colored instead of underlined
ZSH_HIGHLIGHT_STYLES[path]='fg=white'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=cyan,bold'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=cyan,bold'
VI_MODE_SET_CURSOR=true

# zsh autoupdate
DISABLE_AUTO_UPDATE=true
# vim:ft=zsh:
